        "sharpen": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Sharpen",
          "type": "number"
        },
        "grain": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Grain",
          "type": "number"
        },
        "lights": {
