          "enum": [
            "video",
            "audio",
            "camera"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "description": "video tracks only: leave out of the picture",
          "title": "Hidden",
          "type": "boolean"
        },
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "pan": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Pan",
          "type": "number"
