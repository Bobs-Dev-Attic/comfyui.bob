{
  "$defs": {
    "CamKey": {
      "description": "A camera keyframe at source time `t` (the clip's own time, so trims keep it in place).\nA missing value carries the move's own setting.",
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "ease": {
          "default": "smooth",
          "enum": [
            "smooth",
            "linear",
            "hold"
          ],
          "title": "Ease",
          "type": "string"
        },
        "pan": {
          "anyOf": [
            {
              "maximum": 80,
              "minimum": -80,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pan"
        },
        "tilt": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tilt"
        },
        "roll": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roll"
        },
        "zoom": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0.3,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zoom"
        },
        "dolly": {
          "anyOf": [
            {
              "maximum": 0.9,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dolly"
        },
        "truck": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truck"
        },
        "pedestal": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": -2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pedestal"
        },
        "orbit": {
          "anyOf": [
            {
              "maximum": 80,
              "minimum": -80,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orbit"
        }
      },
      "required": [
        "t"
      ],
      "title": "CamKey",
      "type": "object"
    },
    "CameraMove": {
      "description": "A virtual camera move over the picture below it (Camera track). Angles in degrees;\nzoom \u00d7; dolly toward the picture (0.5 = half way); truck / pedestal in picture widths/heights.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "pan": {
          "default": 0,
          "maximum": 80,
          "minimum": -80,
          "title": "Pan",
          "type": "number"
        },
        "tilt": {
          "default": 0,
          "maximum": 60,
          "minimum": -60,
          "title": "Tilt",
          "type": "number"
        },
        "roll": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Roll",
          "type": "number"
        },
        "zoom": {
          "default": 1,
          "maximum": 5,
          "minimum": 0.3,
          "title": "Zoom",
          "type": "number"
        },
        "dolly": {
          "default": 0,
          "maximum": 0.9,
          "minimum": -2,
          "title": "Dolly",
          "type": "number"
        },
        "truck": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "Truck",
          "type": "number"
        },
        "pedestal": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "Pedestal",
          "type": "number"
        },
        "orbit": {
          "default": 0,
          "maximum": 80,
          "minimum": -80,
          "title": "Orbit",
          "type": "number"
        },
        "shake": {
          "default": 0,
          "description": "handheld shake",
          "maximum": 1,
          "minimum": 0,
          "title": "Shake",
          "type": "number"
        },
        "fill": {
          "default": "black",
          "description": "what shows where the move uncovers the frame",
          "enum": [
            "black",
            "blur"
          ],
          "title": "Fill",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/CamKey"
          },
          "maxItems": 200,
          "title": "Keys",
          "type": "array"
        },
        "reshoot": {
          "$ref": "#/$defs/Reshoot"
        }
      },
      "title": "CameraMove",
      "type": "object"
    },
    "Clip": {
      "description": "A piece of a media file placed on a track. Times are seconds.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "track": {
          "title": "Track",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "camera"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "where the clip begins on the timeline",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "trim_in": {
          "default": 0,
          "description": "first second of the source used",
          "minimum": 0,
          "title": "Trim In",
          "type": "number"
        },
        "trim_out": {
          "description": "last second of the source used (exclusive)",
          "exclusiveMinimum": 0,
          "title": "Trim Out",
          "type": "number"
        },
        "source_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "length of the source file; None for stills",
          "title": "Source Duration"
        },
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "color": {
          "default": "",
          "title": "Color",
          "type": "string"
        },
        "job": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the studio result this clip came from",
          "title": "Job"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clips sharing a link id move, trim, split and delete together",
          "title": "Link"
        },
        "audio_off": {
          "default": false,
          "description": "video clip whose own sound is off because a linked audio clip carries it",
          "title": "Audio Off",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "description": "this clip's sound is off",
          "title": "Muted",
          "type": "boolean"
        },
        "pan": {
          "default": 0,
          "description": "-1 = left, 0 = centre, 1 = right",
          "maximum": 1,
          "minimum": -1,
          "title": "Pan",
          "type": "number"
        },
        "fade_in": {
          "default": 0,
          "description": "seconds of sound fade-in at the clip's start",
          "minimum": 0,
          "title": "Fade In",
          "type": "number"
        },
        "fade_out": {
          "default": 0,
          "description": "seconds of sound fade-out at the clip's end",
          "minimum": 0,
          "title": "Fade Out",
          "type": "number"
        },
        "fx": {
          "anyOf": [
            {
              "$ref": "#/$defs/VideoFx"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "picture effects: grading, lights, vignette, blur, grain"
        },
        "vol_keys": {
          "description": "volume keyframes (replace `volume`)",
          "items": {
            "$ref": "#/$defs/VolKey"
          },
          "maxItems": 500,
          "title": "Vol Keys",
          "type": "array"
        },
        "cam": {
          "anyOf": [
            {
              "$ref": "#/$defs/CameraMove"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "camera clips only: the move"
        }
      },
      "required": [
        "track",
        "ref",
        "kind",
        "trim_out"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Frames": {
      "properties": {
        "first_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/PictureRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/PictureRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Frames",
      "type": "object"
    },
    "FxKey": {
      "description": "A keyframe: the animatable Fx settings at one moment. `t` is in the clip's source time\n(seconds into the file), so keys stay on the same picture when the clip is trimmed or split.\nBetween two keys values ease with the earlier key's `ease`; before the first and after the\nlast they hold.",
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "ease": {
          "default": "smooth",
          "enum": [
            "smooth",
            "linear",
            "hold"
          ],
          "title": "Ease",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "any of exposure, contrast, saturation, temperature, tint, vignette, blur",
          "title": "Values",
          "type": "object"
        },
        "lights": {
          "description": "per light, any of x, y, radius, intensity, flicker, color",
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object"
          },
          "maxItems": 4,
          "title": "Lights",
          "type": "array"
        }
      },
      "required": [
        "t"
      ],
      "title": "FxKey",
      "type": "object"
    },
    "GalleryConfig": {
      "description": "How the Inputs media gallery looks for this project.",
      "properties": {
        "source": {
          "default": "library",
          "description": "library | results | uploads | vf:<folder id> | bm:<bookmark id>",
          "title": "Source",
          "type": "string"
        },
        "thumb_size": {
          "default": 132,
          "maximum": 320,
          "minimum": 72,
          "title": "Thumb Size",
          "type": "integer"
        },
        "sort": {
          "default": "added",
          "enum": [
            "added",
            "name",
            "modified",
            "kind"
          ],
          "title": "Sort",
          "type": "string"
        },
        "descending": {
          "default": true,
          "title": "Descending",
          "type": "boolean"
        },
        "kind": {
          "default": "all",
          "enum": [
            "all",
            "image",
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "GalleryConfig",
      "type": "object"
    },
    "Library": {
      "properties": {
        "media": {
          "items": {
            "$ref": "#/$defs/MediaItem"
          },
          "title": "Media",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/TagDef"
          },
          "title": "Tags",
          "type": "array"
        },
        "virtual_folders": {
          "items": {
            "$ref": "#/$defs/VirtualFolder"
          },
          "title": "Virtual Folders",
          "type": "array"
        }
      },
      "title": "Library",
      "type": "object"
    },
    "Light": {
      "description": "A light painted onto the picture (ideas from AInVFX Paint a Plate, Apache-2.0).\n\nrelight: multiplies the picture by a soft light ratio, so its texture stays (light falling on things);\nglow: adds light on top (a lamp, a haze); shade: darkens (a shadow, a flag). Position is a fraction\nof the picture; with x2/y2 the light travels there over the clip.",
      "properties": {
        "mode": {
          "default": "relight",
          "enum": [
            "relight",
            "glow",
            "shade"
          ],
          "title": "Mode",
          "type": "string"
        },
        "x": {
          "default": 0.5,
          "description": "0 = left edge, 1 = right edge",
          "maximum": 1.5,
          "minimum": -0.5,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.35,
          "description": "0 = top, 1 = bottom",
          "maximum": 1.5,
          "minimum": -0.5,
          "title": "Y",
          "type": "number"
        },
        "x2": {
          "anyOf": [
            {
              "maximum": 1.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where it ends up at the clip's end (None = still)",
          "title": "X2"
        },
        "y2": {
          "anyOf": [
            {
              "maximum": 1.5,
              "minimum": -0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        },
        "radius": {
          "default": 0.35,
          "description": "soft radius, \u00d7 the picture's shorter side",
          "maximum": 3,
          "minimum": 0.02,
          "title": "Radius",
          "type": "number"
        },
        "intensity": {
          "default": 1.0,
          "maximum": 4,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "color": {
          "default": "#ffd890",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "flicker": {
          "default": 0,
          "description": "0 = steady, 1 = strong flicker (fire, a failing bulb)",
          "maximum": 1,
          "minimum": 0,
          "title": "Flicker",
          "type": "number"
        }
      },
      "title": "Light",
      "type": "object"
    },
    "Marker": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "color": {
          "default": "",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "t"
      ],
      "title": "Marker",
      "type": "object"
    },
    "Master": {
      "description": "The final mix.",
      "properties": {
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "loudness": {
          "anyOf": [
            {
              "maximum": -6,
              "minimum": -36,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "normalise to this many LUFS (e.g. -14 for web, -23 for broadcast); None = off",
          "title": "Loudness"
        },
        "limiter": {
          "default": true,
          "description": "catch peaks so the mix never clips",
          "title": "Limiter",
          "type": "boolean"
        }
      },
      "title": "Master",
      "type": "object"
    },
    "MediaItem": {
      "description": "A file in the project's library. Only the reference is stored; the file stays where it is.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ref": {
          "description": "data/uploads/\u2026, outputs/\u2026, or an absolute path inside a bookmarked folder",
          "title": "Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "camera"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "added": {
          "title": "Added",
          "type": "number"
        },
        "source": {
          "default": "other",
          "enum": [
            "upload",
            "output",
            "bookmark",
            "other"
          ],
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "rating": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Rating",
          "type": "integer"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "kind",
        "name"
      ],
      "title": "MediaItem",
      "type": "object"
    },
    "PictureRef": {
      "description": "A picture used as an input: `ref` is what the server reads, `url` what the browser shows.",
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "PictureRef",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": true,
      "properties": {
        "gallery": {
          "$ref": "#/$defs/GalleryConfig"
        },
        "writer": {
          "$ref": "#/$defs/WriterConfig"
        },
        "autosave": {
          "default": true,
          "description": "save changes automatically; off = save with Ctrl+S or the Save button",
          "title": "Autosave",
          "type": "boolean"
        },
        "autosave_delay": {
          "default": 0.7,
          "description": "seconds after the last change before saving",
          "maximum": 300,
          "minimum": 0.2,
          "title": "Autosave Delay",
          "type": "number"
        },
        "defaults": {
          "additionalProperties": true,
          "description": "settings a reset goes back to",
          "title": "Defaults",
          "type": "object"
        }
      },
      "title": "ProjectConfig",
      "type": "object"
    },
    "Reshoot": {
      "description": "Settings of the AI reshoot of a camera move (see app/camera.py).",
      "properties": {
        "prompt": {
          "default": "",
          "maxLength": 4000,
          "title": "Prompt",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "References",
          "type": "array"
        },
        "guides": {
          "default": 3,
          "description": "guide frames, the first and last included",
          "maximum": 6,
          "minimum": 2,
          "title": "Guides",
          "type": "integer"
        },
        "quality": {
          "default": "draft",
          "title": "Quality",
          "type": "string"
        },
        "seed": {
          "default": -1,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "Reshoot",
      "type": "object"
    },
    "StudioSettings": {
      "additionalProperties": true,
      "description": "The studio form, saved as you work. Unknown keys are kept so newer versions can add fields.",
      "properties": {
        "v": {
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "image",
                "video",
                "audio",
                "camera"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "engine": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "model per kind, e.g. {'video': 'h3ref'}",
          "title": "Engine",
          "type": "object"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "lyrics": {
          "default": "",
          "title": "Lyrics",
          "type": "string"
        },
        "aspect": {
          "default": "16:9",
          "title": "Aspect",
          "type": "string"
        },
        "quality": {
          "default": "draft",
          "title": "Quality",
          "type": "string"
        },
        "seconds": {
          "default": 5,
          "title": "Seconds",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "default": -1,
          "title": "Seed"
        },
        "steps": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": "",
          "title": "Steps"
        },
        "batch": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Batch",
          "type": "integer"
        },
        "turbo": {
          "default": true,
          "title": "Turbo",
          "type": "boolean"
        },
        "enhance": {
          "default": false,
          "title": "Enhance",
          "type": "boolean"
        },
        "fidelity": {
          "default": false,
          "title": "Fidelity",
          "type": "boolean"
        },
        "refs": {
          "description": "H3 Reference pictures, in <Picture N> order",
          "items": {
            "$ref": "#/$defs/PictureRef"
          },
          "title": "Refs",
          "type": "array"
        },
        "frames": {
          "$ref": "#/$defs/Frames"
        }
      },
      "title": "StudioSettings",
      "type": "object"
    },
    "TagDef": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "color": {
          "default": "",
          "description": "CSS colour; empty = automatic",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "TagDef",
      "type": "object"
    },
    "Timeline": {
      "description": "The project's edit: tracks, clips, markers and view state. Saved as you work.",
