{
  "$defs": {
    "Clip": {
      "description": "A piece of a media file placed on a track. Times are seconds.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "track": {
          "title": "Track",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "start": {
          "default": 0,
          "description": "where the clip begins on the timeline",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "trim_in": {
          "default": 0,
          "description": "first second of the source used",
          "minimum": 0,
          "title": "Trim In",
          "type": "number"
        },
        "trim_out": {
          "description": "last second of the source used (exclusive)",
          "exclusiveMinimum": 0,
          "title": "Trim Out",
          "type": "number"
        },
        "source_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "length of the source file; None for stills",
          "title": "Source Duration"
        },
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "color": {
          "default": "",
          "title": "Color",
          "type": "string"
        },
        "job": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the studio result this clip came from",
          "title": "Job"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "clips sharing a link id move, trim, split and delete together",
          "title": "Link"
        },
        "audio_off": {
          "default": false,
          "description": "video clip whose own sound is off because a linked audio clip carries it",
          "title": "Audio Off",
          "type": "boolean"
        },
        "muted": {
          "default": false,
          "description": "this clip's sound is off",
          "title": "Muted",
          "type": "boolean"
        },
        "pan": {
          "default": 0,
          "description": "-1 = left, 0 = centre, 1 = right",
          "maximum": 1,
          "minimum": -1,
          "title": "Pan",
          "type": "number"
        },
        "fade_in": {
          "default": 0,
          "description": "seconds of sound fade-in at the clip's start",
          "minimum": 0,
          "title": "Fade In",
          "type": "number"
        },
        "fade_out": {
          "default": 0,
          "description": "seconds of sound fade-out at the clip's end",
          "minimum": 0,
          "title": "Fade Out",
          "type": "number"
        }
      },
      "required": [
        "track",
        "ref",
        "kind",
        "trim_out"
      ],
      "title": "Clip",
      "type": "object"
    },
    "Frames": {
      "properties": {
        "first_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/PictureRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/PictureRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Frames",
      "type": "object"
    },
    "GalleryConfig": {
      "description": "How the Inputs media gallery looks for this project.",
      "properties": {
        "source": {
          "default": "library",
          "description": "library | results | uploads | vf:<folder id> | bm:<bookmark id>",
          "title": "Source",
          "type": "string"
        },
        "thumb_size": {
          "default": 132,
          "maximum": 320,
          "minimum": 72,
          "title": "Thumb Size",
          "type": "integer"
        },
        "sort": {
          "default": "added",
          "enum": [
            "added",
            "name",
            "modified",
            "kind"
          ],
          "title": "Sort",
          "type": "string"
        },
        "descending": {
          "default": true,
          "title": "Descending",
          "type": "boolean"
        },
        "kind": {
          "default": "all",
          "enum": [
            "all",
            "image",
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "GalleryConfig",
      "type": "object"
    },
    "Library": {
      "properties": {
        "media": {
          "items": {
            "$ref": "#/$defs/MediaItem"
          },
          "title": "Media",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/TagDef"
          },
          "title": "Tags",
          "type": "array"
        },
        "virtual_folders": {
          "items": {
            "$ref": "#/$defs/VirtualFolder"
          },
          "title": "Virtual Folders",
          "type": "array"
        }
      },
      "title": "Library",
      "type": "object"
    },
    "Marker": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "color": {
          "default": "",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "t"
      ],
      "title": "Marker",
      "type": "object"
    },
    "Master": {
      "description": "The final mix.",
      "properties": {
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "loudness": {
          "anyOf": [
            {
              "maximum": -6,
              "minimum": -36,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "normalise to this many LUFS (e.g. -14 for web, -23 for broadcast); None = off",
          "title": "Loudness"
        },
        "limiter": {
          "default": true,
          "description": "catch peaks so the mix never clips",
          "title": "Limiter",
          "type": "boolean"
        }
      },
      "title": "Master",
      "type": "object"
    },
    "MediaItem": {
      "description": "A file in the project's library. Only the reference is stored; the file stays where it is.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ref": {
          "description": "data/uploads/\u2026, outputs/\u2026, or an absolute path inside a bookmarked folder",
          "title": "Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "added": {
          "title": "Added",
          "type": "number"
        },
        "source": {
          "default": "other",
          "enum": [
            "upload",
            "output",
            "bookmark",
            "other"
          ],
          "title": "Source",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "rating": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Rating",
          "type": "integer"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "kind",
        "name"
      ],
      "title": "MediaItem",
      "type": "object"
    },
    "PictureRef": {
      "description": "A picture used as an input: `ref` is what the server reads, `url` what the browser shows.",
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "PictureRef",
      "type": "object"
    },
    "ProjectConfig": {
      "additionalProperties": true,
      "properties": {
        "gallery": {
          "$ref": "#/$defs/GalleryConfig"
        },
        "writer": {
          "$ref": "#/$defs/WriterConfig"
        },
        "autosave": {
          "default": true,
          "description": "save changes automatically; off = save with Ctrl+S or the Save button",
          "title": "Autosave",
          "type": "boolean"
        },
        "autosave_delay": {
          "default": 0.7,
          "description": "seconds after the last change before saving",
          "maximum": 300,
          "minimum": 0.2,
          "title": "Autosave Delay",
          "type": "number"
        },
        "defaults": {
          "additionalProperties": true,
          "description": "settings a reset goes back to",
          "title": "Defaults",
          "type": "object"
        }
      },
      "title": "ProjectConfig",
      "type": "object"
    },
    "StudioSettings": {
      "additionalProperties": true,
      "description": "The studio form, saved as you work. Unknown keys are kept so newer versions can add fields.",
      "properties": {
        "v": {
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "image",
                "video",
                "audio"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "engine": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "model per kind, e.g. {'video': 'h3ref'}",
          "title": "Engine",
          "type": "object"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        },
        "lyrics": {
          "default": "",
          "title": "Lyrics",
          "type": "string"
        },
        "aspect": {
          "default": "16:9",
          "title": "Aspect",
          "type": "string"
        },
        "quality": {
          "default": "draft",
          "title": "Quality",
          "type": "string"
        },
        "seconds": {
          "default": 5,
          "title": "Seconds",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "default": -1,
          "title": "Seed"
        },
        "steps": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": "",
          "title": "Steps"
        },
        "batch": {
          "default": 1,
          "maximum": 4,
          "minimum": 1,
          "title": "Batch",
          "type": "integer"
        },
        "turbo": {
          "default": true,
          "title": "Turbo",
          "type": "boolean"
        },
        "enhance": {
          "default": false,
          "title": "Enhance",
          "type": "boolean"
        },
        "fidelity": {
          "default": false,
          "title": "Fidelity",
          "type": "boolean"
        },
        "refs": {
          "description": "H3 Reference pictures, in <Picture N> order",
          "items": {
            "$ref": "#/$defs/PictureRef"
          },
          "title": "Refs",
          "type": "array"
        },
        "frames": {
          "$ref": "#/$defs/Frames"
        }
      },
      "title": "StudioSettings",
      "type": "object"
    },
    "TagDef": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "color": {
          "default": "",
          "description": "CSS colour; empty = automatic",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "TagDef",
      "type": "object"
    },
    "Timeline": {
      "description": "The project's edit: tracks, clips, markers and view state. Saved as you work.",
      "properties": {
        "fps": {
          "default": 24,
          "maximum": 120,
          "minimum": 1,
          "title": "Fps",
          "type": "integer"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "title": "Tracks",
          "type": "array"
        },
        "clips": {
          "items": {
            "$ref": "#/$defs/Clip"
          },
          "title": "Clips",
          "type": "array"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "title": "Markers",
          "type": "array"
        },
        "playhead": {
          "default": 0,
          "minimum": 0,
          "title": "Playhead",
          "type": "number"
        },
        "zoom": {
          "default": 60,
          "description": "pixels per second",
          "maximum": 1200,
          "minimum": 2,
          "title": "Zoom",
          "type": "number"
        },
        "range_in": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range In"
        },
        "range_out": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range Out"
        },
        "snap": {
          "default": true,
          "title": "Snap",
          "type": "boolean"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "title": "Transitions",
          "type": "array"
        },
        "link_audio": {
          "default": true,
          "description": "adding a video with sound also puts its sound on an audio track",
          "title": "Link Audio",
          "type": "boolean"
        },
        "link_audio_track": {
          "default": "new",
          "description": "new = a new audio track for each video; free = the first free audio track",
          "enum": [
            "new",
            "free"
          ],
          "title": "Link Audio Track",
          "type": "string"
        },
        "master": {
          "$ref": "#/$defs/Master"
        },
        "render": {
          "additionalProperties": true,
          "description": "export settings: width, height, crf",
          "title": "Render",
          "type": "object"
        }
      },
      "title": "Timeline",
      "type": "object"
    },
    "Track": {
      "description": "A lane on the timeline. Upper video tracks cover lower ones.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "muted": {
          "default": false,
          "title": "Muted",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "hidden": {
          "default": false,
          "description": "video tracks only: leave out of the picture",
          "title": "Hidden",
          "type": "boolean"
        },
        "volume": {
          "default": 1.0,
          "maximum": 2,
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        },
        "pan": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Pan",
          "type": "number"
        },
        "solo": {
          "default": false,
          "description": "when any track is soloed, only soloed tracks are heard",
          "title": "Solo",
          "type": "boolean"
        },
        "height": {
          "default": 56,
          "maximum": 200,
          "minimum": 28,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "Track",
      "type": "object"
    },
    "Transition": {
      "description": "Two clips on the same track overlap and blend: `a` plays out while `b` comes in.\nIts length is the overlap (a.end \u2212 b.start); each clip uses its own frames.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "track": {
          "title": "Track",
          "type": "string"
        },
        "a": {
          "description": "outgoing clip id",
          "title": "A",
          "type": "string"
        },
        "b": {
          "description": "incoming clip id",
          "title": "B",
          "type": "string"
        },
        "type": {
          "default": "fade",
          "description": "one of TRANSITIONS (ffmpeg xfade names)",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "track",
        "a",
        "b"
      ],
      "title": "Transition",
      "type": "object"
    },
    "VirtualFolder": {
      "description": "A saved view of the library: every item whose tags match. Items aren't moved or copied.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match",
          "type": "string"
        },
        "kinds": {
          "description": "empty = every kind",
          "items": {
            "enum": [
              "image",
              "video",
              "audio"
            ],
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "created": {
          "title": "Created",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "VirtualFolder",
      "type": "object"
    },
    "WriterConfig": {
      "description": "Prompt writer preferences for this project (None = use the app's).",
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "dialogue": {
          "default": false,
          "title": "Dialogue",
          "type": "boolean"
        },
        "shots": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shots"
        }
      },
      "title": "WriterConfig",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema": {
      "default": "bob.project/2",
      "title": "Schema",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "created": {
      "title": "Created",
      "type": "number"
    },
    "modified": {
      "title": "Modified",
      "type": "number"
    },
    "app_version": {
      "default": "0.12.0",
      "title": "App Version",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "thumb": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thumb"
    },
    "settings": {
      "$ref": "#/$defs/StudioSettings"
    },
    "config": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "library": {
      "$ref": "#/$defs/Library"
    },
    "timeline": {
      "$ref": "#/$defs/Timeline"
    }
  },
  "required": [
    "name"
  ],
  "title": "Bob Studio project (bob.project/2)",
  "type": "object",
  "$id": "https://github.com/Bobs-Dev-Attic/comfyui.bob/docs/project.schema.json"
}
