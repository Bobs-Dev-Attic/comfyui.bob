# Copy to .env (gitignored) and fill in what you need. Real environment
# variables override these. Never commit .env or put real keys in this file.

# ComfyUI and the comfy-api-proxy the app starts for comfy-sdk
COMFYUI_URL=http://127.0.0.1:8188
COMFY_BASE_URL=http://127.0.0.1:8189
BOB_AUTO_START_PROXY=1

# ComfyUI extra_model_paths.yaml file(s), ";"-separated. The studio reads them to
# find models on disk that the running ComfyUI isn't loading.
BOB_EXTRA_MODEL_PATHS=

# Optional: the ComfyUI install start.bat starts when ComfyUI isn't running. Use a
# ComfyUI folder or a ComfyUI_windows_portable folder, plus any extra arguments.
BOB_COMFYUI_DIR=
BOB_COMFYUI_ARGS=

# Where projects are saved (default: the projects folder next to the app)
BOB_PROJECTS_DIR=

# ffmpeg for video and sound thumbnails (default: found on PATH)
BOB_FFMPEG=

# Web server
BOB_HOST=127.0.0.1
BOB_PORT=8700

# Prompt writer: "ollama" or "openai" (any OpenAI-compatible server)
BOB_LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
BOB_OLLAMA_MODEL=
BOB_OLLAMA_KEEP_ALIVE=0
BOB_LLM_URL=http://127.0.0.1:8080
BOB_LLM_MODEL=

# Secret. Bearer token for the OpenAI-compatible server (e.g. llama-server --api-key).
# Only sent to BOB_LLM_URL, never shown in the UI or returned by the API.
BOB_LLM_API_KEY=
